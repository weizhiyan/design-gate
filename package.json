{
  "name": "design-gate",
  "version": "0.1.0",
  "description": "Figma 设计稿 vs 前端实现 自动化验收门禁：结构化参数比对为主，视觉截图为辅，输出验收报告。MCP server + CLI。",
  "type": "module",
  "main": "./dist/engine.js",
  "bin": {
    "design-gate": "./dist/cli.js",
    "design-gate-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:mcp": "npm run build && node scripts/mcp-test.mjs",
    "mcp": "node dist/mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.52.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
